# Copy to .env (git-ignored) and change every value.
DB_USER=m2its
DB_PASSWORD=change-me-db-password
DB_ROOT_PASSWORD=change-me-root-password
# At least 32 characters. Generate one with:  openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-48-chars-min
JWT_ISSUER=m2i-online-exam
# First super admin, created only if this e-mail does not exist yet.
BOOTSTRAP_ADMIN_EMAIL=platform.admin@m2i.local
BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-password
API_DOCS_ENABLED=true
